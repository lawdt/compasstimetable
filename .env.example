# Токен бота из @BotFather
BOT_TOKEN=

# Адрес миниаппа, например https://compass-timetable.netlify.app
WEBAPP_URL=

# Произвольная строка: Telegram присылает её в заголовке вебхука
WEBHOOK_SECRET=

# Публикация таблицы (необязательно — по умолчанию берётся таблица школы)
SHEET_URL=
SHEET_GID=

# Supabase — только для навыка Алисы
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Откуда навык берёт расписание (по умолчанию адрес миниаппа)
SCHEDULE_URL=

# Supabase: статистика открытий. Секретный ключ нужен только функции
# weekly-stats на Netlify и scripts/stats-local.mjs
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Куда бот шлёт сообщения об ошибках и отчёт по понедельникам
OWNER_CHAT_ID=
